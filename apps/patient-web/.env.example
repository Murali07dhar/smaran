# Relative API base (D6): dev proxy / reverse proxy forwards /api, /ws and /api/v1/voice.
VITE_API_BASE_URL=/api/v1
# Leave empty to derive ws(s)://<current host>/ws/coop/... from window.location.
VITE_WS_BASE_URL=
VITE_VOICE_BASE_URL=/api/v1/voice
VITE_USE_MOCKS=false
VITE_EMOTION_MODEL_URL=/models/emotion-fusion.onnx
# Dev proxy target (vite.config.ts)
DEV_PROXY_API=http://localhost:8000
DEV_PROXY_VOICE=http://localhost:8002
