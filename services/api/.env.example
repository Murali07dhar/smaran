# Copy to .env (never commit .env). All values below are placeholders.
ENVIRONMENT=development                 # development | test | production
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://smaran:smaran@localhost:5432/smaran
REDIS_URL=redis://localhost:6379/0
# >= 32 chars. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
# base64 of 32 random bytes (AES-256-GCM, media at rest). Generate: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# Required when ENVIRONMENT=production.
MEDIA_KEY_B64=
AI_SERVICE_URL=http://localhost:8001
VOICE_SERVICE_URL=http://localhost:8002
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
BCRYPT_ROUNDS=12
# Integration/CI: fail startup if any module is missing or broken.
STRICT_MODULES=false
# Dev only: path to mocks/api_stubs to serve 501 stubs for missing modules.
MODULE_STUBS_PATH=
# seed.py demo password (DEV ONLY)
SEED_PASSWORD=Smaran-Demo-123

# --- auth_consent (1.2) tuning, optional, defaults shown ---
PATIENT_PIN_TTL_MIN=10
PATIENT_QR_TTL_MIN=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MIN=15

# --- sync + coop (1.4), optional. NOTE: read with os.getenv, so set them in the real environment
# (docker compose `environment:` / shell), not only in a .env file. ---
COOP_USE_LUA=1
COOP_BACKLOG_SIZE=200
SYNC_PULL_HOLDBACK_SECONDS=0


# media (1.3)
MEDIA_DIR=/data/media
MEDIA_URL_TTL_SECONDS=600
SQL_ECHO=false
JWT_ALGORITHM=HS256
JWT_ISSUER=smaran
