# services/voice
VOICE_MODELS_MODE=auto        # auto | off
VOICE_MODEL_DIR=/models
VOICE_DEVICE=cpu              # cpu | cuda
VOICE_REQUIRE_AUTH=true
JWT_SECRET=change-me          # must match services/api signing config
JWT_ALGORITHM=HS256
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
VOICE_MAX_AUDIO_BYTES=5242880
VOICE_MAX_TTS_CHARS=400
