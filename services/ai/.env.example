# SMARAN AI service (:8001). Copy to .env. Never commit real values.
AI_ENV=development                 # production => AI_SERVICE_TOKEN is mandatory
AI_STATE_DB=data/ai_state.db       # SQLite file (use an encrypted volume in production)
AI_SERVICE_TOKEN=                  # bearer token the API (services/api) must send to /ai/*
AI_ALLOW_TIME_OVERRIDE=0           # 1 only in tests/demos: honours X-Smaran-Now header

# Gemini (optional; template fallback is used when empty or offline)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_S=6

# MLflow (optional; JSON fallback logging is used when unset)
MLFLOW_TRACKING_URI=
