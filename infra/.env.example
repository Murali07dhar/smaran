# SMARAN environment. Copy to infra/.env  (make env does this) and edit the secrets.
# NEVER commit infra/.env.  `make up` refuses to start while a secret is empty or a "change-me" placeholder.
# Generate values with:  sh infra/scripts/gen_secrets.sh

# ---- Secrets (required) ------------------------------------------------------------------
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
# 32 random bytes, base64 (AES-256-GCM media key)
MEDIA_KEY_B64=change-me-generate-with-openssl-rand-base64-32
POSTGRES_PASSWORD=change-me-use-letters-and-digits-only
REDIS_PASSWORD=change-me-use-letters-and-digits-only

# ---- Settings read by services/api (app.core.config.settings) ------------------------------
# docker compose builds the in-network values itself; these host-style values are for running
# api tooling OUTSIDE Docker (pytest against Postgres, alembic, seed scripts).
DATABASE_URL=postgresql+psycopg://smaran:change-me-use-letters-and-digits-only@localhost:5432/smaran
REDIS_URL=redis://:change-me-use-letters-and-digits-only@localhost:6379/0
AI_SERVICE_URL=http://localhost:8001
VOICE_SERVICE_URL=http://localhost:8002

# ---- Postgres container --------------------------------------------------------------------
POSTGRES_USER=smaran
POSTGRES_DB=smaran

# ---- AI service ----------------------------------------------------------------------------
# Gemini key comes from the environment only. Variable name is an ASSUMPTION: align with services/ai.
GEMINI_API_KEY=

# ---- PROPOSED settings (see HANDOFF.md "Contract change requests") -------------------------
# MEDIA_DIR=/data/media                      # set by compose
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174   # only needed when NOT using the nginx proxy

# ---- Host ports / build options ------------------------------------------------------------
API_PORT=8000
AI_PORT=8001
VOICE_PORT=8002
POSTGRES_PORT=5432
REDIS_PORT=6379
PATIENT_WEB_PORT=5173
CAREGIVER_WEB_PORT=5174
VITE_API_BASE_URL=/api/v1
API_REQUIREMENTS_FILE=services/api/requirements.txt
INSIGHTS_SCAN_INTERVAL_MINUTES=360

# ---- Production override (docker-compose.prod.yml) -----------------------------------------
SMARAN_DOMAIN=
ACME_EMAIL=

# ---- settings added at integration (every app.core.config.Settings field is listed) ----
ENVIRONMENT=production                 # development | test | production
# STRICT_MODULES / MEDIA_DIR / AI_SERVICE_URL / VOICE_SERVICE_URL are fixed by docker-compose.yml
MEDIA_URL_TTL_SECONDS=600              # signed media URL lifetime (30..3600)
SYNC_PULL_HOLDBACK_SECONDS=0           # Postgres cursor-visibility mitigation for /sync/pull
LOG_LEVEL=INFO
SQL_ECHO=false
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
PATIENT_PIN_TTL_MIN=10
PATIENT_QR_TTL_MIN=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MIN=15
JWT_ALGORITHM=HS256
JWT_ISSUER=smaran
BCRYPT_ROUNDS=12
# MODULE_STUBS_PATH= (dev only; there are no stubs left in the repo)
